# SET_DATA_URL is a Google Sheets URL; the CLI derives its XLSX export URL.
# The sheet must be accessible for XLSX export. Use a sanitized copy if needed.
# The CLI uses Bash, Ruby standard library, curl, and unzip (no Python).
# Each command downloads a fresh snapshot to ./downloads before processing.
SET_DATA_URL=
SET_DATA_SHEET=All-ThaiMutualFunds-MTFS

# Required for read-only SEC fund NAV requests. Keep this key local in .env.
SEC_API_KEY_FUND=
