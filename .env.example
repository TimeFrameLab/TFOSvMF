# UPDATE and CANDIDATE require XLSX-export link access. Never expose a workbook
# containing personal/portfolio data; use a sanitized copy instead.
# UPDATE and CANDIDATE download the latest snapshot to ./downloads.
SET_DATA_URL=
SET_DATA_SHEET=All-ThaiMutualFunds-MTFS

# Required for read-only SEC fund NAV requests. Keep this key local in .env.
SEC_API_KEY_FUND=
